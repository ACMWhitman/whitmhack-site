# JWT_SECRET: a random string used to encrypt admin access tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_your_own_generated_secret

# ADMIN_PASSWORD_HASH: bcrypt hash of your chosen admin password.
# Generate with: node -e "console.log(require('bcryptjs').hashSync('YOUR_CHOSEN_PASSWORD', 10))"
# Then paste the output (a string starting with $2a$) here.
ADMIN_PASSWORD_HASH=replace_with_your_own_bcrypt_hash